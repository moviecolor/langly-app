default_platform(:ios)

EN_NEWS = "Subscription update — Langly Premium now available."
PT_NEWS = "Atualização por assinatura — Langly Premium agora disponível."

lane :beta do
  api_key = app_store_connect_api_key(
    key_id: "87CV539PA4",
    issuer_id: "69a6de78-dca8-47e3-e053-5b8c7c11a4d1",
    key_filepath: File.expand_path("~/.appstoreconnect/keys/AuthKey_87CV539PA4.p8"),
    in_house: false,
  )

  build_app(
    export_options: {
      method: "app-store",
      automatic_signing: true,
    },
    scheme: "Langly",
    configuration: "Release",
    export_method: "app-store",
    clean: true,
    xcargs: "-allowProvisioningUpdates",
  )

  upload_to_testflight(
    api_key: api_key,
    changelog: EN_NEWS + "\n" + PT_NEWS,
    skip_waiting_for_build_processing: false,
  )
end
